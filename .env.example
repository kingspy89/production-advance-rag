# ============================================================================
# ENTERPRISE AGENTIC RAG - ENVIRONMENT VARIABLES TEMPLATE
# ============================================================================
# Copy this file to .env and fill in your actual credentials
# DO NOT commit .env to version control — it contains secrets

# --- VECTOR DATABASE (REQUIRED) ---
QDRANT_CLUSTER_ENDPOINT=https://your-cluster.us-east.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# --- EMBEDDINGS (CHOOSE ONE) ---
# Primary: Google Gemini (3072-dimensional, high quality)
GEMINI_API_KEY=your_gemini_api_key_here
EMBEDDING_PROVIDER=gemini  # Options: 'gemini' or 'local'

# If using local embeddings only (all-mpnet-base-v2, 768-dim):
# EMBEDDING_PROVIDER=local
# GEMINI_API_KEY=  # Leave empty

# --- LLM PROVIDER (REQUIRED) ---
# Primary Groq API key for LLM generation
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GUARD_MODEL=qwen/qwen3.8-27b

# Fallback Groq API key (optional, for rate limit redundancy)
GROQ_FALLBACK_API_KEY=your_fallback_groq_key_here
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# --- PORTKEY GATEWAY (OPTIONAL - Enables Caching & Observability) ---
# Leave empty to use direct Groq calls (no caching)
PORTKEY_API_KEY=your_portkey_api_key_here
PORTKEY_CONFIG_ID=pc-your-config-id-here  # Or leave empty for inline config

# --- OBSERVABILITY (OPTIONAL) ---
# Pydantic Logfire - APM monitoring
LOGFIRE_TOKEN=your_logfire_token_here  # Leave empty for local-only logging

# LangSmith - LangChain/LangGraph tracing
LANGSMITH_TRACING=true  # Set to 'false' to disable
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=rag_production
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- EVALUATION (OPTIONAL) ---
# Separate Groq key for evaluation runs (prevents quota exhaustion)
JUDGE_GROQ=your_judge_groq_key_here

# --- UI CONFIGURATION (OPTIONAL) ---
# Backend URL for Streamlit UI (defaults to http://localhost:8000 if empty)
BACKEND_URL=http://localhost:8000

# ============================================================================
# SECURITY NOTES
# ============================================================================
# 1. Never commit .env to Git
# 2. Rotate all credentials every 90 days
# 3. Use separate API keys for dev/staging/production
# 4. For production: migrate to AWS Secrets Manager / Azure Key Vault
# 5. Monitor API key usage in provider dashboards
